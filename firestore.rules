rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    function isReadOnlyOthers() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.readOnlyOthers == true;
    }

    function isOwnUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwnUser(uid) || isAdmin();
      allow create: if isOwnUser(uid)
                    && request.resource.data.admin == false
                    && request.resource.data.readOnlyOthers == false;
      allow update, delete: if isAdmin();
    }

    match /characters/{characterId} {
      allow read: if isAdmin() || isReadOnlyOthers()
                     || (isAuthenticated() && resource.data.email.lower() == request.auth.token.email.lower());
      allow write: if isAdmin();
      // The one non-admin write: an owner collecting a beaten boss's reward
      // (BossRepository.claimReward), batched with the boss's `rewarded`
      // entry -- see isBossRewardClaim.
      allow update: if isBossRewardClaim(characterId);
    }

    // A number on a character as the app reads it: legacy React data may
    // hold a numeric string, a missing field counts as 0.
    function asNumber(data, key) {
      return !(key in data) || data[key] == null ? 0
           : (data[key] is string ? float(data[key]) : data[key]);
    }

    // Every XP the character ever gained (`xp_earned`, never lowered by a
    // level-up), or current_xp before the first XP write records it. Boss
    // energy is counted on this, so it never drops.
    function earnedXp(data) {
      return data.get('xp_earned', asNumber(data, 'current_xp'));
    }

    function ownsCharacter(characterId) {
      return isAuthenticated()
          && get(/databases/$(database)/documents/characters/$(characterId))
               .data.email.lower() == request.auth.token.email.lower();
    }

    // XP and gold must move by exactly the reward (earned XP by its rise);
    // trait values cannot be checked without loops, so only the list's
    // growth is bounded.
    function isBossRewardClaim(characterId) {
      let before = resource.data;
      let after = request.resource.data;
      let bossPath = /databases/$(database)/documents/bosses/$(after.lastBossRewardId);
      let boss = get(bossPath).data;
      let reward = boss.reward;
      return isAuthenticated()
          && before.email.lower() == request.auth.token.email.lower()
          && after.diff(before).affectedKeys()
               .hasOnly(['current_xp', 'xp_earned', 'gold', 'traits', 'lastBossRewardId'])
          && boss.status == 'defeated'
          && boss.damage.get(characterId, 0) > 0
          && !(characterId in boss.rewarded)
          && getAfter(bossPath).data.rewarded.get(characterId, false) == true
          && ('current_xp' in reward
                ? after.current_xp == asNumber(before, 'current_xp') + reward.current_xp
                  && earnedXp(after) == earnedXp(before)
                       + (reward.current_xp > 0 ? reward.current_xp : 0)
                : !after.diff(before).affectedKeys().hasAny(['current_xp', 'xp_earned']))
          && ('gold' in reward
                ? after.gold == asNumber(before, 'gold') + reward.gold
                : !after.diff(before).affectedKeys().hasAny(['gold']))
          && ('traits' in reward
                ? after.traits.size() <= before.get('traits', []).size() + reward.traits.size()
                : !after.diff(before).affectedKeys().hasAny(['traits']));
    }

    match /bosses/{bossId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || isBossAttack()
                    || isBossJoin()
                    || isBossClaim(bossId);

      function targets(boss, characterId) {
        return boss.get('targetCharacterId', null) == null
            || boss.targetCharacterId == characterId;
      }

      // One blow (BossRepository.attack): exactly one tier's cost/damage
      // pair, paid from XP earned since the boss appeared.
      function isBossAttack() {
        let before = resource.data;
        let after = request.resource.data;
        let c = after.lastAttackerId;
        let paid = after.spent.get(c, 0) - before.spent.get(c, 0);
        let dealt = after.damage.get(c, 0) - before.damage.get(c, 0);
        let character = get(/databases/$(database)/documents/characters/$(c)).data;
        return isAuthenticated()
            && before.status == 'active'
            && targets(before, c)
            && character.email.lower() == request.auth.token.email.lower()
            && after.diff(before).affectedKeys().hasOnly(
                 ['hp', 'spent', 'damage', 'lastAttackerId', 'lastAttackerName', 'status', 'defeatedAt'])
            && after.spent.diff(before.spent).affectedKeys().hasOnly([c])
            && after.damage.diff(before.damage).affectedKeys().hasOnly([c])
            && ((paid == 1 && dealt == 1) || (paid == 10 && dealt == 10)
                || (paid == 50 && dealt == 60) || (paid == 100 && dealt == 150))
            && c in before.baseline
            && after.spent[c] <= earnedXp(character) - before.baseline[c]
            && ((before.hp > dealt && after.hp == before.hp - dealt
                   && after.status == 'active' && !('defeatedAt' in after))
                || (before.hp <= dealt && after.hp == 0
                   && after.status == 'defeated' && after.defeatedAt == request.time));
      }

      // A character created after the boss appeared joins with its earned
      // XP as baseline (BossRepository.join).
      function isBossJoin() {
        let before = resource.data;
        let after = request.resource.data;
        let c = after.lastJoinedId;
        let character = get(/databases/$(database)/documents/characters/$(c)).data;
        return isAuthenticated()
            && before.status == 'active'
            && targets(before, c)
            && character.email.lower() == request.auth.token.email.lower()
            && after.diff(before).affectedKeys().hasOnly(['baseline', 'lastJoinedId'])
            && !(c in before.baseline)
            && after.baseline.diff(before.baseline).affectedKeys().hasOnly([c])
            && after.baseline[c] == earnedXp(character);
      }

      // The boss half of a reward claim; the character half is
      // isBossRewardClaim, and each requires the other via getAfter.
      function isBossClaim(bossId) {
        let before = resource.data;
        let after = request.resource.data;
        let c = after.lastClaimId;
        return ownsCharacter(c)
            && before.status == 'defeated'
            && before.damage.get(c, 0) > 0
            && !(c in before.rewarded)
            && after.diff(before).affectedKeys().hasOnly(['rewarded', 'lastClaimId'])
            && after.rewarded.diff(before.rewarded).affectedKeys().hasOnly([c])
            && after.rewarded[c] == true
            && getAfter(/databases/$(database)/documents/characters/$(c))
                 .data.get('lastBossRewardId', null) == bossId;
      }
    }

    match /change_requests/{requestId} {
      // A non-admin's read is only granted for their own requests, so the
      // client must keep issuing where('requesterUid', isEqualTo: <own uid>)
      // -- an unconstrained collection query is rejected outright, exactly as
      // it is for /characters.
      allow read: if isAdmin()
                     || (isAuthenticated()
                         && resource.data.requesterUid == request.auth.uid);

      // A request must be posted in your own name, against your own
      // character, and as pending: the decision fields are the admin's to
      // write, never the requester's.
      allow create: if isAuthenticated()
                    && request.resource.data.requesterUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && !('decidedBy' in request.resource.data)
                    && !('decidedAt' in request.resource.data)
                    && !('appliedChanges' in request.resource.data)
                    && request.resource.data.changes.keys().size() > 0
                    && get(/databases/$(database)/documents/characters/$(request.resource.data.characterId))
                         .data.email.lower() == request.auth.token.email.lower()
                    // An electronics-day claim is its own kind of request:
                    // the date the player tapped, nothing else alongside it.
                    && (!('electronics_claim' in request.resource.data.changes)
                        || (request.resource.data.changes.keys().hasOnly(['electronics_claim'])
                            && request.resource.data.changes.electronics_claim is string
                            && request.resource.data.changes.electronics_claim.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));

      // Accepting also writes /characters/{id}, which is already admin-only,
      // so the whole apply path runs as an admin. The one non-admin path is
      // a requester withdrawing their own still-pending request: that may
      // only flip status to 'cancelled' and touch no other field.
      allow update: if isAdmin()
                    || (isAuthenticated()
                        && resource.data.requesterUid == request.auth.uid
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'cancelled'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }

    match /quests/{questId} {
      // Board and log are visible to everyone signed in.
      allow read: if isAuthenticated();

      // A direct assignment's target must be on the public roster
      // (quest_roster) with a matching email -- shared by the ordinary
      // direct-assign branch and the daily-quest branch below.
      function isValidRosterAssignment() {
        return exists(/databases/$(database)/documents/quest_roster/$(request.resource.data.assignedToCharacterId))
            && get(/databases/$(database)/documents/quest_roster/$(request.resource.data.assignedToCharacterId))
                 .data.email.lower() == request.resource.data.assignedToEmail.lower();
      }

      // Posted in your own name, never a raw gold delta, and one of:
      //  - open, with no assignment (the board);
      //  - assigned directly to a roster character (any user, for their own
      //    or someone else's character -- see quest_roster);
      //  - a daily quest, admin-only, either directly assigned (a personal
      //    standing chore) or open with no assignment (a "dailyShared"
      //    chore anyone can take from the board -- see CLAUDE.md's Daily
      //    Quests section).
      allow create: if isAuthenticated()
                    && request.resource.data.posterUid == request.auth.uid
                    && request.resource.data.posterEmail.lower() == request.auth.token.email.lower()
                    && request.resource.data.reward.keys().hasAny(['current_xp', 'traits'])
                    && !('gold' in request.resource.data.reward)
                    && !('electronics_claim' in request.resource.data.reward)
                    && (
                      (
                        (!('isDaily' in request.resource.data) || request.resource.data.isDaily == false)
                        && request.resource.data.status == 'open'
                        && !('assignedToCharacterId' in request.resource.data)
                      )
                      ||
                      (
                        (!('isDaily' in request.resource.data) || request.resource.data.isDaily == false)
                        && request.resource.data.status == 'assigned'
                        && isValidRosterAssignment()
                      )
                      ||
                      (
                        request.resource.data.isDaily == true
                        && isAdmin()
                        && (
                          (request.resource.data.status == 'assigned' && isValidRosterAssignment())
                          ||
                          (request.resource.data.status == 'open'
                            && !('assignedToCharacterId' in request.resource.data))
                        )
                      )
                    );

      allow update: if isAdmin()
                    // take: open -> assigned, by the taker, for their own character
                    || (isAuthenticated()
                        && resource.data.status == 'open'
                        && request.resource.data.status == 'assigned'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'assignedToCharacterId', 'assignedToCharacterName', 'assignedToEmail'])
                        && request.resource.data.assignedToEmail.lower() == request.auth.token.email.lower()
                        && get(/databases/$(database)/documents/characters/$(request.resource.data.assignedToCharacterId))
                             .data.email.lower() == request.auth.token.email.lower())
                    // abandon: assigned -> open, by the current holder
                    || (isAuthenticated()
                        && resource.data.status == 'assigned'
                        && request.resource.data.status == 'open'
                        && resource.data.assignedToEmail.lower() == request.auth.token.email.lower()
                        && !('assignedToCharacterId' in request.resource.data)
                        && !('assignedToCharacterName' in request.resource.data)
                        && !('assignedToEmail' in request.resource.data)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'assignedToCharacterId', 'assignedToCharacterName', 'assignedToEmail']))
                    // withdraw: open -> cancelled, by the poster
                    || (isAuthenticated()
                        && resource.data.status == 'open'
                        && request.resource.data.status == 'cancelled'
                        && resource.data.posterUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
                    // edit: title/description/reward, by the poster, while still
                    // open -- status/assignment/poster identity are fixed at
                    // creation and untouchable here, so a directly-assigned
                    // quest (which never reaches 'open') can never hit this path
                    || (isAuthenticated()
                        && resource.data.status == 'open'
                        && request.resource.data.status == 'open'
                        && resource.data.posterUid == request.auth.uid
                        && request.resource.data.reward.keys().hasAny(['current_xp', 'traits'])
                        && !('gold' in request.resource.data.reward)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['title', 'description', 'reward']))
                    // mark complete: assigned -> pending_review, by the current holder.
                    // lastCompletedDate is only ever set here when the quest is
                    // daily (QuestRepository.markComplete), but it's allowed as an
                    // optional key for both kinds rather than branching the rule
                    // on isDaily.
                    || (isAuthenticated()
                        && resource.data.status == 'assigned'
                        && request.resource.data.status == 'pending_review'
                        && resource.data.assignedToEmail.lower() == request.auth.token.email.lower()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'changeRequestId', 'lastCompletedDate']));

      allow delete: if false;
    }

    match /quest_roster/{characterId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
